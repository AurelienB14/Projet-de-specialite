{% extends 'base.html.twig' %}

{% block title %} Setup #{{ setup.id }} {% endblock %}

{% block body %}

    <div class="user-detail">
        <h1>Setup #{{ setup.id }}</h1>
        <p><strong>Processeur :</strong> {{ setup.processeur }}</p>
        <p><strong>Mémoire RAM :</strong> {{ setup.memoire }} Go</p>
        <p><strong>Carte graphique :</strong> {{ setup.carteGraphique }}</p>
        <p><strong>Stockage :</strong> {{ setup.stockage }} Go</p>
    </div>
{% endblock %}