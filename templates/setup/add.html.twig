{% extends 'base.html.twig' %}

{% block body %}

<div>
    <h1>Creer ton ordinateur<h2>

    {{ form_start(form, { 'attr': {'enctype': 'multipart/form-data'} }) }}
    <div class="form">
        <div class= "form-group">
            {{ form_label(form.processeur, 'Processeur') }}
            {{ form_widget(form.processeur, { 'attr': {'class': 'input-form', 'placeholder': 'Processeur'} }) }}
            {{ form_errors(form.processeur) }}
        </div>
        <div class= "form-group">
            {{ form_label(form.memoire, 'Memoire') }}
            {{ form_widget(form.memoire, { 'attr': {'class': 'input-form', 'placeholder': 'Memoire'} }) }}
            {{ form_errors(form.memoire) }}
        </div>
        <div class= "form-group">
            {{ form_label(form.carte_graphique, 'Carte Graphique') }}
            {{ form_widget(form.carte_graphique, { 'attr': {'class': 'input-form', 'placeholder': 'Carte Graphique'} }) }}
            {{ form_errors(form.carte_graphique) }}
        </div>
        <div class= "form-group">
            {{ form_label(form.stockage, 'Stockage') }}
            {{ form_widget(form.stockage, { 'attr': {'class': 'input-form', 'placeholder': 'Stockage'} }) }}
            {{ form_errors(form.stockage) }}
        </div>

                <button type="submit" class="btn">Créer</button>

    </div>
    {{ form_end(form) }}
</div>

{% endblock %}
